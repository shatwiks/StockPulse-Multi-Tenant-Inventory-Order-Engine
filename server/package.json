{
  "name": "stockpulse-server",
  "version": "1.0.0",
  "description": "StockPulse Multi-Tenant Inventory & Order Engine Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "node ../node_modules/typescript/bin/tsc",
    "start": "node ./node_modules/tsx/dist/cli.mjs src/server.ts",
    "dev": "node ./node_modules/tsx/dist/cli.mjs src/server.ts",
    "db:generate": "node ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node ./node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:dev": "node ./node_modules/prisma/build/index.js migrate dev",
    "db:push": "node ./node_modules/prisma/build/index.js db push",
    "db:seed": "node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:studio": "node ./node_modules/prisma/build/index.js studio",
    "test:constraints": "node ./node_modules/tsx/dist/cli.mjs scripts/verify-constraints.ts",
    "test:checkout": "node ./node_modules/tsx/dist/cli.mjs scripts/test-concurrent-checkout.ts",
    "test:phase2": "node ./node_modules/tsx/dist/cli.mjs scripts/verify-phase2.ts"
  },
  "prisma": {
    "seed": "node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
  "keywords": [
    "multi-tenant",
    "b2b",
    "inventory",
    "order-engine",
    "express",
    "postgresql",
    "prisma",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "npm:bcryptjs@^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
