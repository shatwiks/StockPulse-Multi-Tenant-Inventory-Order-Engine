datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

enum ProductStatus {
  ACTIVE
  DRAFT
  DISCONTINUED
  OUT_OF_STOCK
}

enum OrderStatus {
  COMPLETED
  HELD
  CANCELLED
}

// -----------------------------------------------------------------------------
// 1. Organizations (Tenant Root)
// -----------------------------------------------------------------------------

model Organization {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String             @db.VarChar(255)
  slug      String             @unique @db.VarChar(100)
  currency  String             @default("USD") @db.VarChar(3)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Tenant-owned Relations
  users      User[]
  categories Category[]
  products   Product[]
  orders     Order[]
  orderItems OrderItem[]

  @@map("organizations")
}

// -----------------------------------------------------------------------------
// 2. Users (Scoped to Tenant Organization)
// -----------------------------------------------------------------------------

model User {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email        String   @db.VarChar(255)
  firstName    String   @default("") @map("first_name") @db.VarChar(100)
  lastName     String   @default("") @map("last_name") @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, email], name: "unique_org_email")
  @@index([organizationId, role])
  @@map("users")
}

// -----------------------------------------------------------------------------
// 3. Categories (Tenant-Owned Taxonomy)
// -----------------------------------------------------------------------------

model Category {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String    @db.VarChar(150)
  slug        String    @default("") @db.VarChar(150)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@unique([organizationId, slug], name: "unique_org_category_slug")
  @@index([organizationId, name])
  @@map("categories")
}

// -----------------------------------------------------------------------------
// 4. Products (Tenant-Owned Inventory Items with Stock Constraint)
// -----------------------------------------------------------------------------

model Product {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  categoryId String?   @map("category_id") @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  sku           String        @db.VarChar(100)
  name          String        @db.VarChar(255)
  description   String?       @db.Text
  unitPrice     Decimal       @map("unit_price") @db.Decimal(10, 2)
  costPrice     Decimal?      @map("cost_price") @db.Decimal(10, 2)
  stockQuantity Int           @default(0) @map("stock_quantity")
  reorderLevel  Int           @default(10) @map("reorder_level")
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItems OrderItem[]

  // Composite Unique: Disallows duplicate SKU within the same tenant
  @@unique([organizationId, sku], name: "unique_org_sku")

  // Requested Composite Indexes:
  // 1. (organization_id, sku) for high-performance SKU lookups per tenant
  @@index([organizationId, sku], name: "idx_products_org_sku")

  // 2. (organization_id, created_at DESC) for paginated inventory feeds per tenant
  @@index([organizationId, createdAt(sort: Desc)], name: "idx_products_org_created_at_desc")

  // Supporting Indexes
  @@index([organizationId, categoryId])
  @@index([organizationId, status])
  @@map("products")
}

// -----------------------------------------------------------------------------
// 5. Orders (Tenant-Owned Customer Orders)
// -----------------------------------------------------------------------------

model Order {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  orderNumber   String      @default(dbgenerated("('ORD-' || to_char(now(), 'YYYYMMDD-') || substr(gen_random_uuid()::text, 1, 8))")) @map("order_number") @db.VarChar(100)
  customerName  String      @map("customer_name") @db.VarChar(255)
  customerEmail String?     @map("customer_email") @db.VarChar(255)
  totalAmount   Decimal     @default(0) @map("total_amount") @db.Decimal(10, 2)
  taxAmount     Decimal     @default(0) @map("tax_amount") @db.Decimal(10, 2)
  status        OrderStatus @default(COMPLETED)
  notes         String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  items OrderItem[]

  @@unique([organizationId, orderNumber], name: "unique_org_order_number")

  // Requested Composite Index:
  // (organization_id, created_at DESC) for paginated order histories per tenant
  @@index([organizationId, createdAt(sort: Desc)], name: "idx_orders_org_created_at_desc")

  @@index([organizationId, status])
  @@map("orders")
}

// -----------------------------------------------------------------------------
// 6. Order Items (Tenant-Scoped Line Items)
// -----------------------------------------------------------------------------

model OrderItem {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity   Int      @default(1)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal  @default(0) @map("total_price") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
