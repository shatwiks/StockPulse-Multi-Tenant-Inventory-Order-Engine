{
  "name": "stockpulse-engine",
  "version": "1.0.0",
  "private": true,
  "description": "StockPulse: Multi-Tenant B2B Inventory & Order Engine",
  "workspaces": [
    "frontend",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,frontend\" -c \"blue,green\" \"npm run dev --prefix server\" \"npm run dev --prefix frontend\"",
    "build": "npm run build --prefix server && npm run build --prefix frontend",
    "dev:server": "npm run dev --prefix server",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:server": "npm run build --prefix server",
    "build:frontend": "npm run build --prefix frontend",
    "db:migrate": "npm run db:migrate --prefix server",
    "db:seed": "npm run db:seed --prefix server",
    "db:push": "npm run db:push --prefix server",
    "test:constraints": "npm run test:constraints --prefix server",
    "test:checkout": "npm run test:checkout --prefix server",
    "test:phase2": "npm run test:phase2 --prefix server",
    "test:phase3": "npm run test:phase3 --prefix server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
