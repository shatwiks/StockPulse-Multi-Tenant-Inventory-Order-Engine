{
  "name": "stockpulse-backend",
  "version": "1.0.0",
  "description": "StockPulse Multi-Tenant Inventory & Order Engine Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "node -e \"require('typescript/bin/tsc')\"",
    "start": "node --import tsx src/server.ts",
    "dev": "node --import tsx --watch src/server.ts",
    "db:generate": "node -e \"require('prisma/build/index.js')\" generate && node -e \"const fs=require('fs'),p=require('path');const s=p.join(__dirname,'node_modules/.prisma'),d=p.join(__dirname,'../node_modules/.prisma');if(fs.existsSync(s)&&fs.existsSync(p.join(__dirname,'../node_modules'))){fs.cpSync(s,d,{recursive:true});}\"",
    "db:migrate": "node -e \"require('prisma/build/index.js')\" migrate deploy",
    "db:migrate:dev": "node -e \"require('prisma/build/index.js')\" migrate dev",
    "db:push": "node -e \"require('prisma/build/index.js')\" db push",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:studio": "node -e \"require('prisma/build/index.js')\" studio",
    "test:constraints": "node --import tsx scripts/verify-constraints.ts",
    "test:checkout": "node --import tsx scripts/test-concurrent-checkout.ts",
    "test:phase2": "node --import tsx scripts/verify-phase2.ts",
    "test:phase3": "node --import tsx scripts/verify-phase3.ts",
    "test:categories": "node --import tsx scripts/verify-categories.ts",
    "test:analytics-org": "node --import tsx scripts/verify-analytics-org.ts",
    "test:concurrency-demo": "node --import tsx scripts/verify-concurrency-demo.ts",
    "test:health": "node --import tsx scripts/verify-system-health.ts",
    "test:docs": "node --import tsx scripts/verify-api-docs.ts"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "keywords": [
    "multi-tenant",
    "b2b",
    "inventory",
    "order-engine",
    "express",
    "postgresql",
    "prisma",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "npm:bcryptjs@^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
